{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/posts(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/courses(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/resources(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/marketplace(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/universities(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/upload(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/health(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
